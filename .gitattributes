# Default: let Git detect text files and store them with LF
* text=auto eol=lf

# Windows scripts need CRLF to run properly
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Shell scripts must stay LF (gradlew included)
gradlew text eol=lf
*.sh    text eol=lf

# Binary files: never touch
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.jar  binary
*.zip  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.nbt  binary
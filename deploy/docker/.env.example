# Copy to .env next to docker-compose.yml and fill in every value BEFORE the first start.
#   cp .env.example .env && chmod 600 .env
# Generate passwords and the secret with: openssl rand -hex 32

# MariaDB: the hub's user, and root (only used if you ever need a shell in the database)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Signs admin sign-in tokens. Keep it fixed, or every restart signs every admin out.
JWT_SECRET=

# Dashboard `admin` and the bot's `discord-bot` account. Read only on the boot that creates them:
# change them later on the dashboard's Admins page, not here.
ADMIN_PASSWORD=
BOT_PASSWORD=

# Discord Developer Portal -> Your App -> Bot -> Token
DISCORD_TOKEN=
# Discord Developer Portal -> Your App -> General Information -> Application ID
CLIENT_ID=
# Right-click your Discord server -> Copy Server ID (needs Developer Mode on)
GUILD_ID=

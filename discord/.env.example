# Copy this file to `.env` and fill in the values (never commit .env).
# Discord Developer Portal -> Your App -> Bot -> Token
DISCORD_TOKEN=
# Discord Developer Portal -> Your App -> General Information -> Application ID
CLIENT_ID=
# Right-click your Discord server -> Copy Server ID (needs Developer Mode on)
GUILD_ID=
# WTC Lodestone hub base URL and a dedicated admin account seeded there via
# `lodestone.admins` (see hub/src/main/resources/application.yaml)
HUB_URL=http://127.0.0.1:8080
HUB_USERNAME=discord-bot
HUB_PASSWORD=